---
import { getLangFromUrl } from '@/i18n/langUtils';
import { getHeaderTranslations } from './index';
import MainHeader from '@/components/shared/navigation/Header/MainHeader.astro';

// Example of how to use the header translations in a component
const lang = getLangFromUrl(Astro.url);
const t = getHeaderTranslations(lang);
---

<!-- Example usage of the Header translations -->
<div class="prose max-w-none">
  <h2>Example Header Translation Usage</h2>
  
  <h3>Navigation Items</h3>
  <ul>
    <li>About: {t.navigation.about}</li>
    <li>Programs: {t.navigation.programs}</li>
    <li>Universities: {t.navigation.universities}</li>
    <li>Blog: {t.navigation.blog}</li>
    <li>Contact: {t.navigation.contact}</li>
  </ul>
  
  <h3>CTA Button</h3>
  <p>Apply Button: {t.cta.applyButton}</p>
  
  <h3>Mobile Menu</h3>
  <p>Menu Toggle: {t.mobileMenu.menu}</p>
  <p>Close Menu: {t.mobileMenu.close}</p>
</div>

<!-- Full Header Component Example -->
<MainHeader /> 