---
import Layout from '@/layouts/Layout.astro';
import { getFeaturedPosts, getLatestPosts, getPostsByCategory, blogPosts, type BlogCategory } from '@/lib/blog';
import BlogHeader from '@/components/features/blog/BlogHeader.astro';
import Breadcrumb from '@/components/features/blog/Breadcrumb.astro';
import SearchBar from '@/components/features/blog/SearchBar.astro';
import CategoryFilter from '@/components/features/blog/CategoryFilter.astro';
import { languages, type Lang } from '@/i18n/langUtils';
import BlogTester from '@/components/features/blog/BlogTester.astro';
import { getBlogCommonTranslations } from '@/i18n/features/blog/common';
import FeaturedPosts from '@/components/features/blog/FeaturedPosts.astro';
import LatestPosts from '@/components/features/blog/LatestPosts.astro';
import AllPosts from '@/components/features/blog/AllPosts.astro';

// Define the getStaticPaths function required for dynamic routes
export function getStaticPaths() {
  return languages.map(lang => ({
    params: { lang }
  }));
}

// Get the language from the URL parameter
const { lang } = Astro.params;

// Validate the language parameter
if (!lang || !languages.includes(lang as Lang)) {
  return Astro.redirect('/uz/'); // Redirect to default language if invalid
}

// Get translations
const t = getBlogCommonTranslations(lang as Lang);

// Get blog data
const featuredPosts = getFeaturedPosts();
const latestPosts = getLatestPosts(3);

// Get category from URL query parameter, if any
const categoryParam = Astro.url.searchParams.get('category');
const selectedCategory = categoryParam || 'all';

// Get all posts or posts filtered by category
const allPosts = selectedCategory === 'all' ? blogPosts : getPostsByCategory(selectedCategory as BlogCategory);

// Meta data for the page
const meta = {
  title: "Учебный блог | Study in China",
  description: "Образовательный блог о учебе в Китае. Советы, гайды и полезная информация для студентов."
};

// Breadcrumb items
const breadcrumbItems = [
  { label: 'Ресурсы', href: `/${lang}/resources` },
  { label: t.breadcrumb.blog, href: `/${lang}/study-blog`, active: true },
];
---

<Layout meta={meta}>
  <div class="min-h-screen bg-gradient-to-b from-blue-50 to-indigo-50">
    <div class="container py-8 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
      <!-- Breadcrumbs -->
      <Breadcrumb items={breadcrumbItems} lang={lang as Lang} />
      
      <!-- Header and Search Area -->
      <div class="mt-6 mb-10">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-8">
          <BlogHeader lang={lang as Lang} />
          <div class="w-full md:w-auto md:min-w-[300px]">
            <SearchBar lang={lang as Lang} />
          </div>
        </div>
        
        <CategoryFilter selectedCategory={selectedCategory} lang={lang as Lang} />
      </div>
      
      <div class="my-6 border-t border-gray-200"></div>
      
      <!-- Featured Posts Section - Only shown when no filter is active -->
      {selectedCategory === 'all' && <FeaturedPosts lang={lang as Lang} />}
      
      {selectedCategory === 'all' && (
        <div class="my-6 border-t border-gray-200"></div>
      )}
      
      <!-- Latest Posts Section - Only shown when no filter is active -->
      {selectedCategory === 'all' && <LatestPosts lang={lang as Lang} count={3} />}
      
      {selectedCategory === 'all' ? (
        <div class="my-6 border-t border-gray-200"></div>
      ) : null}
      
      <!-- All/Filtered Posts Section -->
      <AllPosts lang={lang as Lang} selectedCategory={selectedCategory} />
      
      <!-- Include BlogTester only in development mode -->
      {import.meta.env.DEV && <BlogTester />}
    </div>
  </div>
</Layout>

<style>
  .animate-fade-in {
    animation: fadeIn 0.6s ease-in-out forwards;
  }
  
  .animate-slide-up {
    opacity: 0;
    transform: translateY(20px);
    animation: slideUp 0.6s ease-out forwards;
  }
  
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  
  @keyframes slideUp {
    from { 
      opacity: 0;
      transform: translateY(20px);
    }
    to { 
      opacity: 1;
      transform: translateY(0);
    }
  }
</style> 