---
import { cn } from '@/lib/utils';
import { Home, ChevronRight } from 'lucide-astro';
import type { Lang } from '@/i18n/langUtils';
import { getBlogCommonTranslations } from '@/i18n/features/blog/common';

interface Props {
  items: {
    label: string;
    href: string;
    active?: boolean;
  }[];
  lang?: Lang;
}
const { items, lang = 'uz' } = Astro.props;
const t = getBlogCommonTranslations(lang);
---

<nav>
  <ol class="flex items-center space-x-1 text-sm">
    <li class="flex items-center">
      <a 
        href={`/${lang}`} 
        class="flex items-center text-gray-500 hover:text-blue-600 transition-colors"
      >
        <Home class="h-4 w-4" />
        <span class="sr-only">{t.breadcrumb.home}</span>
      </a>
    </li>
    {items.map((item, index) => (
      <>
        <li class="flex items-center">
          <ChevronRight class="h-3 w-3 text-gray-400" />
        </li>
        <li>
          <a
            href={item.href}
            class={cn(
              "transition-colors hover:text-blue-600",
              item.active ? "text-gray-900 font-medium" : "text-gray-500"
            )}
          >
            {item.label}
          </a>
        </li>
      </>
    ))}
  </ol>
</nav> 