---
import { cn } from "@/lib/utils";
import type { Lang } from '@/i18n/langUtils';
import { getBlogCommonTranslations } from '@/i18n/features/blog/common';

interface Props {
  className?: string;
  lang?: Lang;
}

const { className, lang = 'uz' } = Astro.props;
const t = getBlogCommonTranslations(lang);
// Import any necessary icons/utilities
---

<header class={cn("w-full animate-fade-in", className)}>
  <div>
    <h1 class="text-3xl font-bold text-blue-800">{t.header.title}</h1>
    <p class="text-gray-600 mt-1">
      {t.header.subtitle}
    </p>
  </div>
</header>

<style>
  .animate-fade-in {
    animation: fadeIn 0.6s ease-in-out forwards;
  }
  
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
</style> 