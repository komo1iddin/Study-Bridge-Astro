---
import UniversityDetailPageComponent from './UniversityDetailPage.svelte';
import { getLangFromUrl } from '@/i18n/langUtils';

const { university } = Astro.props;
const lang = getLangFromUrl(Astro.url);
---

<!-- Loading Skeleton (will show until client component hydrates) -->
<div id="loading-skeleton" class="min-h-screen w-full bg-gradient-to-br from-blue-50 via-slate-50 to-indigo-50 relative overflow-hidden">
  <div class="absolute inset-0 overflow-hidden opacity-20">
    <div class="absolute -top-40 -right-40 w-80 h-80 bg-blue-400 rounded-full filter blur-3xl"></div>
    <div class="absolute top-60 -left-20 w-80 h-80 bg-purple-400 rounded-full filter blur-3xl"></div>
    <div class="absolute bottom-20 right-20 w-60 h-60 bg-indigo-300 rounded-full filter blur-3xl"></div>
  </div>
  <div class="container mx-auto py-8 px-4 md:px-6 relative z-10 w-full">
    <!-- Breadcrumb skeleton -->
    <div class="flex items-center gap-2 mb-6">
      <div class="h-4 w-4 bg-slate-200 rounded-full animate-pulse"></div>
      <div class="h-4 w-32 bg-slate-200 rounded animate-pulse"></div>
    </div>
    
    <!-- University Detail Skeleton -->
    <div class="grid gap-6 md:grid-cols-3">
      <!-- Main content skeleton -->
      <div class="md:col-span-2 space-y-6">
        <!-- Header card skeleton -->
        <div class="bg-white rounded-xl shadow-sm overflow-hidden">
          <div class="h-48 bg-slate-200 animate-pulse"></div>
          <div class="p-6 space-y-4">
            <div class="h-8 w-3/4 bg-slate-200 rounded animate-pulse"></div>
            <div class="h-4 w-1/2 bg-slate-100 rounded animate-pulse"></div>
            <div class="flex gap-4 pt-4">
              {Array(4).fill(0).map(() => (
                <div class="h-8 w-20 bg-slate-200 rounded animate-pulse"></div>
              ))}
            </div>
          </div>
        </div>
        
        <!-- Content section skeleton -->
        <div class="bg-white rounded-xl shadow-sm p-6 space-y-6">
          <div class="h-6 w-1/3 bg-slate-200 rounded animate-pulse"></div>
          <div class="space-y-3">
            <div class="h-4 w-full bg-slate-100 rounded animate-pulse"></div>
            <div class="h-4 w-full bg-slate-100 rounded animate-pulse"></div>
            <div class="h-4 w-2/3 bg-slate-100 rounded animate-pulse"></div>
          </div>
          <div class="space-y-3">
            <div class="h-6 w-1/4 bg-slate-200 rounded animate-pulse"></div>
            <div class="h-4 w-full bg-slate-100 rounded animate-pulse"></div>
            <div class="h-4 w-5/6 bg-slate-100 rounded animate-pulse"></div>
          </div>
        </div>
      </div>
      
      <!-- Sidebar skeleton -->
      <div class="space-y-6">
        <!-- Application card skeleton -->
        <div class="bg-white rounded-xl shadow-sm p-6 space-y-4">
          <div class="h-6 w-3/4 bg-slate-200 rounded animate-pulse"></div>
          <div class="h-10 w-full bg-blue-100 rounded animate-pulse"></div>
        </div>
        
        <!-- Stats card skeleton -->
        <div class="bg-white rounded-xl shadow-sm p-6 space-y-4">
          <div class="h-6 w-1/2 bg-slate-200 rounded animate-pulse"></div>
          <div class="grid grid-cols-2 gap-4">
            <div class="space-y-2">
              <div class="h-4 w-1/2 bg-slate-100 rounded animate-pulse"></div>
              <div class="h-6 w-3/4 bg-slate-200 rounded animate-pulse"></div>
            </div>
            <div class="space-y-2">
              <div class="h-4 w-1/2 bg-slate-100 rounded animate-pulse"></div>
              <div class="h-6 w-3/4 bg-slate-200 rounded animate-pulse"></div>
            </div>
          </div>
        </div>
        
        <!-- View gallery button skeleton -->
        <div class="h-10 w-full bg-blue-200 rounded animate-pulse"></div>
      </div>
    </div>
  </div>
</div>

<UniversityDetailPageComponent 
  university={university} 
  lang={lang} 
  client:visible 
/>

<script>
  // Hide loading skeleton when Svelte component is mounted
  document.addEventListener('DOMContentLoaded', () => {
    const loadingEl = document.getElementById('loading-skeleton');
    // Add transition
    if (loadingEl) {
      loadingEl.style.transition = 'opacity 0.5s ease-out';
      
      // Listen for when Svelte component is mounted
      window.addEventListener('university-detail-mounted', () => {
        loadingEl.style.opacity = '0';
        setTimeout(() => {
          loadingEl.style.display = 'none';
        }, 500);
      });
      
      // Fallback: hide skeleton after 3 seconds if event doesn't fire
      setTimeout(() => {
        if (loadingEl.style.opacity !== '0') {
          loadingEl.style.opacity = '0';
          setTimeout(() => {
            loadingEl.style.display = 'none';
          }, 500);
        }
      }, 3000);
    }
  });
</script> 