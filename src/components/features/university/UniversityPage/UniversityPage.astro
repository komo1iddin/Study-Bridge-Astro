---
import UniversityPageComponent from './UniversityPage.svelte';
import { getLangFromUrl } from '@/i18n/langUtils';

const { universities, cities } = Astro.props;
const lang = getLangFromUrl(Astro.url);
---

<!-- Loading Skeleton (will show until client component hydrates) -->
<div id="loading-skeleton" class="min-h-screen bg-gradient-to-br from-blue-50 via-slate-50 to-indigo-50 relative overflow-hidden">
  <div class="absolute inset-0 overflow-hidden opacity-20">
    <div class="absolute -top-40 -right-40 w-80 h-80 bg-blue-400 rounded-full filter blur-3xl"></div>
    <div class="absolute top-60 -left-20 w-80 h-80 bg-indigo-400 rounded-full filter blur-3xl"></div>
    <div class="absolute bottom-20 right-20 w-60 h-60 bg-purple-300 rounded-full filter blur-3xl"></div>
  </div>
  
  <div class="relative z-10">
    <div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb skeleton -->
      <div class="flex items-center gap-2 text-sm text-slate-500 mb-6">
        <div class="h-4 w-4 bg-slate-200 rounded-full animate-pulse"></div>
        <div class="h-4 w-32 bg-slate-200 rounded animate-pulse"></div>
      </div>
      
      <div class="flex flex-col lg:flex-row gap-8">
        <!-- Sidebar skeleton -->
        <aside class="hidden lg:block sticky top-8 h-fit md:w-64 lg:w-72 xl:w-80">
          <div class="bg-white rounded-xl shadow-sm p-6 space-y-6">
            <!-- Search skeleton -->
            <div class="space-y-2">
              <div class="h-5 w-1/3 bg-slate-200 rounded animate-pulse"></div>
              <div class="h-10 w-full bg-slate-100 rounded animate-pulse"></div>
            </div>
            
            <!-- Filters skeleton -->
            <div class="space-y-4">
              {Array(3).fill(0).map(() => (
                <div class="space-y-2 border-t border-slate-100 pt-4">
                  <div class="h-5 w-1/2 bg-slate-200 rounded animate-pulse"></div>
                  <div class="space-y-2">
                    {Array(4).fill(0).map(() => (
                      <div class="flex items-center gap-2">
                        <div class="h-4 w-4 rounded-full bg-slate-200 animate-pulse"></div>
                        <div class="h-4 w-24 bg-slate-100 rounded animate-pulse"></div>
                      </div>
                    ))}
                  </div>
                </div>
              ))}
            </div>
            
            <!-- Reset button skeleton -->
            <div class="h-10 w-full bg-slate-100 rounded animate-pulse"></div>
          </div>
        </aside>
        
        <!-- Main content skeleton -->
        <main class="flex-1 max-w-full lg:max-w-[calc(100%-20rem)] xl:max-w-[calc(100%-22rem)]">
          <!-- Filter bar skeleton -->
          <div class="mb-6 p-4 bg-white rounded-lg shadow-sm flex items-center justify-between animate-pulse">
            <div class="h-5 w-32 bg-slate-200 rounded"></div>
            <div class="h-5 w-24 bg-slate-200 rounded"></div>
          </div>
          
          <!-- University cards skeleton -->
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            {Array(6).fill(0).map(() => (
              <div class="bg-white rounded-xl shadow-sm overflow-hidden">
                <div class="h-48 bg-slate-200 animate-pulse"></div>
                <div class="p-6 space-y-4">
                  <div class="h-6 w-3/4 bg-slate-200 rounded animate-pulse"></div>
                  <div class="h-4 w-1/2 bg-slate-100 rounded animate-pulse"></div>
                  <div class="flex flex-wrap gap-2">
                    {Array(3).fill(0).map(() => (
                      <div class="h-6 w-16 bg-blue-100 rounded-full animate-pulse"></div>
                    ))}
                  </div>
                  <div class="pt-2">
                    <div class="h-8 w-full bg-blue-100 rounded animate-pulse"></div>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </main>
      </div>
    </div>
  </div>
</div>

<UniversityPageComponent 
  universities={universities} 
  cities={cities}
  lang={lang} 
  client:visible 
/>

<script>
  // Hide loading skeleton when Svelte component is mounted
  document.addEventListener('DOMContentLoaded', () => {
    const loadingEl = document.getElementById('loading-skeleton');
    if (loadingEl) {
      loadingEl.style.transition = 'opacity 0.5s ease-out';
      
      // Listen for when Svelte component is mounted
      window.addEventListener('university-page-mounted', () => {
        loadingEl.style.opacity = '0';
        setTimeout(() => {
          loadingEl.style.display = 'none';
        }, 500);
      });
      
      // Fallback: hide skeleton after 3 seconds if event doesn't fire
      setTimeout(() => {
        if (loadingEl.style.opacity !== '0') {
          loadingEl.style.opacity = '0';
          setTimeout(() => {
            loadingEl.style.display = 'none';
          }, 500);
        }
      }, 3000);
    }
  });
</script> 