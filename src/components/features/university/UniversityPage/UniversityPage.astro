---
import UniversityPageComponent from "./UniversityPage.svelte";
import { getLangFromUrl } from '@/i18n/langUtils';
import { getAllUniversities, getAllCities } from '@/lib/fileSystemReader';

const lang = getLangFromUrl(Astro.url);
const universities = await getAllUniversities(lang);
const cities = await getAllCities(lang) || [];
---

<!-- Loading Skeleton (will show until client component hydrates) -->
<div id="loading-skeleton" class="min-h-screen bg-gradient-to-br from-blue-50 via-slate-50 to-indigo-50 relative">
  <div class="absolute inset-0 overflow-hidden opacity-20">
    <div class="absolute -top-40 -right-40 w-80 h-80 bg-blue-400 rounded-full filter blur-3xl"></div>
    <div class="absolute top-60 -left-20 w-80 h-80 bg-purple-400 rounded-full filter blur-3xl"></div>
    <div class="absolute bottom-20 right-20 w-60 h-60 bg-indigo-300 rounded-full filter blur-3xl"></div>
  </div>
  <div class="container mx-auto py-8 px-4 md:px-6 relative z-10">
    <!-- Breadcrumb skeleton -->
    <div class="flex items-center gap-2 mb-6">
      <div class="h-4 w-4 bg-slate-200 rounded-full animate-pulse"></div>
      <div class="h-4 w-32 bg-slate-200 rounded animate-pulse"></div>
    </div>
    
    <div class="flex flex-col lg:flex-row gap-8">
      <!-- Sidebar skeleton -->
      <div class="hidden lg:block w-72 space-y-6">
        <div class="bg-white rounded-xl shadow-sm p-6 space-y-4">
          <div class="h-6 w-3/4 bg-slate-200 rounded animate-pulse"></div>
          <div class="space-y-3">
            <div class="h-4 w-full bg-slate-100 rounded animate-pulse"></div>
            <div class="h-10 w-full bg-slate-200 rounded animate-pulse"></div>
          </div>
          <div class="space-y-3">
            <div class="h-4 w-full bg-slate-100 rounded animate-pulse"></div>
            <div class="h-10 w-full bg-slate-200 rounded animate-pulse"></div>
          </div>
          <div class="h-10 w-full bg-blue-100 rounded animate-pulse mt-6"></div>
        </div>
      </div>
      
      <!-- Content skeleton -->
      <div class="flex-1 space-y-6">
        <div class="flex justify-between items-center">
          <div class="h-6 w-1/3 bg-slate-200 rounded animate-pulse"></div>
          <div class="h-6 w-1/4 bg-slate-200 rounded animate-pulse"></div>
        </div>
        
        <!-- University card skeletons -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2 gap-6">
          {Array(4).fill(0).map(() => (
            <div class="bg-white rounded-xl shadow-sm overflow-hidden">
              <div class="h-40 bg-slate-200 animate-pulse"></div>
              <div class="p-6 space-y-4">
                <div class="h-6 w-3/4 bg-slate-200 rounded animate-pulse"></div>
                <div class="space-y-2">
                  <div class="h-4 w-full bg-slate-100 rounded animate-pulse"></div>
                  <div class="h-4 w-2/3 bg-slate-100 rounded animate-pulse"></div>
                </div>
                <div class="flex justify-between">
                  <div class="h-8 w-24 bg-blue-100 rounded animate-pulse"></div>
                  <div class="h-8 w-8 bg-slate-200 rounded-full animate-pulse"></div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>

<UniversityPageComponent 
  universities={universities} 
  cities={cities} 
  lang={lang}
  client:only="svelte"
/>

<script>
  // Hide loading skeleton when Svelte component is hydrated
  document.addEventListener('DOMContentLoaded', () => {
    const loadingEl = document.getElementById('loading-skeleton');
    // Add transition
    if (loadingEl) {
      loadingEl.style.transition = 'opacity 0.5s ease-out';
      
      // Listen for when Svelte component is mounted
      window.addEventListener('svelte-mounted', () => {
        loadingEl.style.opacity = '0';
        setTimeout(() => {
          loadingEl.style.display = 'none';
        }, 500);
      });
      
      // Fallback: hide skeleton after 3 seconds if event doesn't fire
      setTimeout(() => {
        if (loadingEl.style.opacity !== '0') {
          loadingEl.style.opacity = '0';
          setTimeout(() => {
            loadingEl.style.display = 'none';
          }, 500);
        }
      }, 3000);
    }
  });
</script> 