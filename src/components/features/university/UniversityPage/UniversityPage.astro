---
import UniversityPageComponent from "./UniversityPage.svelte";
import { getLangFromUrl } from '@/i18n/langUtils';
import { getAllUniversities, getAllCities } from '@/lib/fileSystemReader';

const lang = getLangFromUrl(Astro.url);
const universities = await getAllUniversities(lang);
const cities = await getAllCities(lang) || [];
---

<div class="min-h-screen university-page-wrapper">
  <UniversityPageComponent 
    universities={universities} 
    cities={cities} 
    lang={lang}
    client:only="svelte"
  />

  <!-- Loading fallback that gets hidden when the component hydrates -->
  <div id="university-page-loading" class="loading-fallback absolute inset-0 z-50 bg-white">
    <div class="min-h-screen w-full flex items-center justify-center">
      <div class="bg-white p-6 rounded-lg shadow-lg max-w-md w-full text-center">
        <div class="space-y-4">
          <div class="h-4 bg-blue-200 rounded w-3/4 mx-auto"></div>
          <div class="h-10 bg-blue-200 rounded w-1/2 mx-auto"></div>
          <div class="space-y-2">
            <div class="h-3 bg-slate-200 rounded"></div>
            <div class="h-3 bg-slate-200 rounded w-5/6"></div>
            <div class="h-3 bg-slate-200 rounded w-4/6"></div>
          </div>
          <div class="text-blue-600 font-medium">Loading universities...</div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .university-page-wrapper {
    position: relative;
  }
</style>

<script>
  // Hide loading UI when component is hydrated
  document.addEventListener('astro:page-load', () => {
    // Small delay to ensure component is fully hydrated
    setTimeout(() => {
      const loadingElement = document.getElementById('university-page-loading');
      if (loadingElement) {
        loadingElement.style.display = 'none';
      }
    }, 300);
  });

  // Fallback in case the above doesn't trigger
  setTimeout(() => {
    const loadingElement = document.getElementById('university-page-loading');
    if (loadingElement) {
      loadingElement.style.display = 'none';
    }
  }, 2000);
</script> 