---
import { GraduationCap, BookOpen, Building, Users, CheckCircle2, ChevronDown } from "lucide-astro";
import type { Lang } from '@/i18n/langUtils';
import ButtonView from '@/components/ui/astro/ButtonView.astro'
import CTA from '@/components/ui/CTA.astro'
import SectionHeader from "@/components/ui/SectionHeader.astro";
import { getLangFromUrl } from '@/i18n/langUtils';
import { getComparisonTranslations } from '@/i18n/features/home/comparison';

interface Props {
  lang?: Lang;
}

const { lang = 'uz' } = Astro.props;
const currentLang = getLangFromUrl(Astro.url);
const t = getComparisonTranslations(currentLang || lang);

const cn = (...classes: (string | undefined | boolean)[]) => {
  return classes.filter(Boolean).join(' ');
};

const categories = [
  {
    id: "education",
    title: t.categories.education.title,
    icon: GraduationCap,
    china: t.categories.education.china,
    uzb: t.categories.education.uzb,
  },
  {
    id: "programs",
    title: t.categories.programs.title,
    icon: BookOpen,
    china: t.categories.programs.china,
    uzb: t.categories.programs.uzb,
  },
  {
    id: "infrastructure",
    title: t.categories.infrastructure.title,
    icon: Building,
    china: t.categories.infrastructure.china,
    uzb: t.categories.infrastructure.uzb,
  },
  {
    id: "teachers",
    title: t.categories.teachers.title,
    icon: Users,
    china: t.categories.teachers.china,
    uzb: t.categories.teachers.uzb,
  },
];

const activeCategory = Astro.url.searchParams.get('category') || 'education';
const activeItem = categories.find((c) => c.id === activeCategory) || categories[0];
---

<section class="container mx-auto py-12 md:py-16 lg:py-20 px-4 md:px-6">
  <!-- Header -->
  <SectionHeader
    title={t.title}
    subtitle={t.subtitle}
  />

  <!-- Category Selector - Mobile -->
  <div class="md:hidden mb-8">
    <div class="max-w-[640px] mx-auto flex flex-col items-center justify-between gap-4 p-4 bg-muted/10 border rounded-lg">
      <div class="text-base font-medium">{t.selectCategory}</div>
      <div class="relative w-full">
        <select 
          id="category-select-mobile"
          class="w-full appearance-none bg-background border rounded-md px-4 py-2 pr-8"
          value={activeCategory}
        >
          {categories.map((category) => (
            <option value={category.id}>{category.title}</option>
          ))}
        </select>
        <ChevronDown class="absolute right-3 top-1/2 -translate-y-1/2 h-4 w-4 pointer-events-none" />
      </div>
    </div>
  </div>

  <!-- Category Pills - Desktop -->
  <div class="hidden md:flex justify-center mb-8">
    <div class="inline-flex p-1 bg-gray-50 border rounded-lg shadow-sm">
      {categories.map((category) => (
        <button
          type="button"
          data-category={category.id}
          class={cn(
            "flex items-center gap-2 px-6 py-3 rounded-md transition-all",
            activeCategory === category.id 
              ? "bg-white shadow-sm border text-primary font-medium" 
              : "hover:bg-gray-100 text-gray-600"
          )}
        >
          <category.icon class="h-4 w-4" />
          <span>{category.title}</span>
        </button>
      ))}
    </div>
  </div>

  <!-- Comparison Content -->
  <div class="max-w-6xl mx-auto">
    <div id="comparison-content">
      <div class="border-2 rounded-xl shadow-sm overflow-hidden">
        <div class="bg-muted/10 border-b pb-3 p-6">
          <div class="flex items-center justify-between">
            <h3 class="font-medium text-xl">{activeItem.title}</h3>
            <div class="text-sm text-muted-foreground">{t.compareAnalysis}</div>
          </div>
        </div>

        <div class="grid md:grid-cols-2 divide-y md:divide-y-0 md:divide-x">
          <!-- China Column -->
          <div class="p-6">
            <div class="flex items-center gap-2 mb-4">
              <div class="h-6 w-6 rounded-full bg-[#DE2910] flex items-center justify-center text-white text-xs font-bold">
                CN
              </div>
              <h4 class="font-medium text-lg">{t.countries.china}</h4>
            </div>
            <hr class="mb-4" />
            <ul class="space-y-4">
              {activeItem.china.map((item) => (
                <li class="flex items-start gap-3">
                  <CheckCircle2 class="h-5 w-5 text-[#DE2910] mt-0.5 flex-shrink-0" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Uzbekistan Column -->
          <div class="p-6">
            <div class="flex items-center gap-2 mb-4">
              <div class="h-6 w-6 rounded-full bg-[#1A5BE1] flex items-center justify-center text-white text-xs font-bold">
                UZ
              </div>
              <h4 class="font-medium text-lg">{t.countries.uzbekistan}</h4>
            </div>
            <hr class="mb-4" />
            <ul class="space-y-4">
              {activeItem.uzb.map((item) => (
                <li class="flex items-start gap-3">
                  <CheckCircle2 class="h-5 w-5 text-[#1A5BE1] mt-0.5 flex-shrink-0" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="bg-muted/10 border-t p-4 text-sm text-muted-foreground">
          {t.dataFrom}
        </div>
      </div>
    </div>
  </div>

  <!-- Buttons -->
  <div class="text-center mt-12">
    <ButtonView
      href={`/${lang}/blog`} 
      text={t.readArticle} 
      variant="mobile" 
      showOnDesktop={false} 
    />
    
    <ButtonView
      href={`/${lang}/blog`} 
      text={t.readArticle} 
      variant="desktop" 
      showOnMobile={false} 
    />
  </div>

  <!-- CTA -->
  <div class="max-w-6xl mx-auto mt-16">
    <CTA />
  </div>
</section>

<!-- Embed translations for client-side use -->
<script id="comparison-translations" type="application/json" set:html={JSON.stringify(t)}></script>

<!-- Client-side JavaScript -->
<script is:inline>
  // Wait for DOM to be fully loaded
  document.addEventListener('DOMContentLoaded', () => {
    initTabs();
  });

  // Initialize tabs functionality
  function initTabs() {
    // Get translations
    let translations;
    try {
      const translationsScript = document.getElementById('comparison-translations');
      if (translationsScript && translationsScript.textContent) {
        translations = JSON.parse(translationsScript.textContent);
      } else {
        console.error('Comparison translations element not found or empty');
        return;
      }
    } catch (e) {
      console.error('Error parsing comparison translations:', e);
      return;
    }

    // Create category map
    const categoryMap = {
      education: {
        title: translations.categories.education.title,
        china: translations.categories.education.china,
        uzb: translations.categories.education.uzb
      },
      programs: {
        title: translations.categories.programs.title,
        china: translations.categories.programs.china,
        uzb: translations.categories.programs.uzb
      },
      infrastructure: {
        title: translations.categories.infrastructure.title,
        china: translations.categories.infrastructure.china,
        uzb: translations.categories.infrastructure.uzb
      },
      teachers: {
        title: translations.categories.teachers.title,
        china: translations.categories.teachers.china,
        uzb: translations.categories.teachers.uzb
      }
    };

    // Main function to switch categories
    function switchCategory(categoryId) {
      // Validate category
      if (!categoryMap[categoryId]) {
        categoryId = 'education'; // Default fallback
      }
      
      const activeCategory = categoryMap[categoryId];
      
      // Get current container dimensions to prevent layout shift
      const contentElement = document.getElementById('comparison-content');
      if (!contentElement) {
        console.error('Comparison content element not found');
        return;
      }
      
      let containerHeight = 0;
      
      if (contentElement.firstElementChild) {
        containerHeight = contentElement.firstElementChild.offsetHeight;
        contentElement.style.width = contentElement.firstElementChild.offsetWidth + 'px';
        contentElement.style.height = containerHeight + 'px';
        contentElement.style.overflow = 'hidden';
      }
      
      // Update URL without reloading
      const url = new URL(window.location.href);
      url.searchParams.set('category', categoryId);
      window.history.pushState({ categoryId }, '', url);
      
      // Update tab styling
      document.querySelectorAll('[data-category]').forEach(el => {
        const isActive = el.getAttribute('data-category') === categoryId;
        
        if (isActive) {
          el.classList.add('bg-white', 'shadow-sm', 'border', 'text-primary', 'font-medium');
          el.classList.remove('hover:bg-gray-100', 'text-gray-600');
        } else {
          el.classList.remove('bg-white', 'shadow-sm', 'border', 'text-primary', 'font-medium');
          el.classList.add('hover:bg-gray-100', 'text-gray-600');
        }
      });
      
      // Update mobile select - using standard JavaScript property access
      const mobileSelect = document.getElementById('category-select-mobile');
      if (mobileSelect) {
        mobileSelect.value = categoryId;
      }
      
      // Generate new HTML
      const contentHTML = `
        <div class="border-2 rounded-xl shadow-sm overflow-hidden">
          <div class="bg-muted/10 border-b pb-3 p-6">
            <div class="flex items-center justify-between">
              <h3 class="font-medium text-xl">${activeCategory.title}</h3>
              <div class="text-sm text-muted-foreground">${translations.compareAnalysis}</div>
            </div>
          </div>

          <div class="grid md:grid-cols-2 divide-y md:divide-y-0 md:divide-x">
            <!-- China Column -->
            <div class="p-6">
              <div class="flex items-center gap-2 mb-4">
                <div class="h-6 w-6 rounded-full bg-[#DE2910] flex items-center justify-center text-white text-xs font-bold">
                  CN
                </div>
                <h4 class="font-medium text-lg">${translations.countries.china}</h4>
              </div>
              <hr class="mb-4" />
              <ul class="space-y-4">
                ${activeCategory.china.map(item => `
                  <li class="flex items-start gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#DE2910" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 mt-0.5 flex-shrink-0">
                      <circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>
                    </svg>
                    <span>${item}</span>
                  </li>
                `).join('')}
              </ul>
            </div>

            <!-- Uzbekistan Column -->
            <div class="p-6">
              <div class="flex items-center gap-2 mb-4">
                <div class="h-6 w-6 rounded-full bg-[#1A5BE1] flex items-center justify-center text-white text-xs font-bold">
                  UZ
                </div>
                <h4 class="font-medium text-lg">${translations.countries.uzbekistan}</h4>
              </div>
              <hr class="mb-4" />
              <ul class="space-y-4">
                ${activeCategory.uzb.map(item => `
                  <li class="flex items-start gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1A5BE1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 mt-0.5 flex-shrink-0">
                      <circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>
                    </svg>
                    <span>${item}</span>
                  </li>
                `).join('')}
              </ul>
            </div>
          </div>

          <div class="bg-muted/10 border-t p-4 text-sm text-muted-foreground">
            ${translations.dataFrom}
          </div>
        </div>
      `;
      
      // Update content
      contentElement.innerHTML = contentHTML;
      
      // Reset dimensions after a short delay to allow new content to render
      setTimeout(() => {
        if (contentElement) {
          contentElement.style.width = '';
          contentElement.style.height = '';
          contentElement.style.overflow = '';
        }
      }, 50);
    }

    // Set up event listeners for desktop tabs
    const tabButtons = document.querySelectorAll('[data-category]');
    tabButtons.forEach(button => {
      button.addEventListener('click', (e) => {
        e.preventDefault();
        const categoryId = button.getAttribute('data-category');
        if (categoryId) {
          switchCategory(categoryId);
        }
      });
    });

    // Set up event listener for mobile select
    const mobileSelect = document.getElementById('category-select-mobile');
    if (mobileSelect) {
      mobileSelect.addEventListener('change', (e) => {
        const categoryId = e.target.value;
        switchCategory(categoryId);
      });
    }

    // Handle browser back/forward navigation
    window.addEventListener('popstate', (e) => {
      if (e.state && e.state.categoryId) {
        switchCategory(e.state.categoryId);
      } else {
        // Fallback to URL parameter or default
        const url = new URL(window.location.href);
        const categoryId = url.searchParams.get('category') || 'education';
        switchCategory(categoryId);
      }
    });

    // Initial load - get category from URL or use default
    const url = new URL(window.location.href);
    const initialCategory = url.searchParams.get('category') || 'education';
    console.log('Initial category:', initialCategory);
    switchCategory(initialCategory);
  }
</script>
