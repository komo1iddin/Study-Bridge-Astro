{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/([^/]+?)/about/?$",
			"dest": "_render"
		},
		{
			"src": "^/([^/]+?)/contacts/?$",
			"dest": "_render"
		},
		{
			"src": "^/([^/]+?)/faq/?$",
			"dest": "_render"
		},
		{
			"src": "^/([^/]+?)/grants/?$",
			"dest": "_render"
		},
		{
			"src": "^/([^/]+?)/programs/bachelor/?$",
			"dest": "_render"
		},
		{
			"src": "^/([^/]+?)/programs/language/?$",
			"dest": "_render"
		},
		{
			"src": "^/([^/]+?)/programs/master/?$",
			"dest": "_render"
		},
		{
			"src": "^/([^/]+?)/programs/?$",
			"dest": "_render"
		},
		{
			"src": "^/([^/]+?)/student-path/?$",
			"dest": "_render"
		},
		{
			"src": "^/([^/]+?)/testimonials/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		}
	]
}