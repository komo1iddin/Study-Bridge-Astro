{
  "redirects": [
    { "source": "/", "destination": "/uz/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/uz/:path*", "destination": "/uz/:path*" },
    { "source": "/ru/:path*", "destination": "/ru/:path*" },
    { "source": "/en/:path*", "destination": "/en/:path*" }
  ],
  "cleanUrls": true,
  "trailingSlash": true
} 